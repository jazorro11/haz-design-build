# Google Sheet: primera fila debe ser cabecera, p. ej.
# timestamp_utc | name | company | email | phone | project_type | message
SPREADSHEET_ID=
SHEET_RANGE=Leads!A:G

# Orígenes del sitio (coma-separados). Obligatorio en producción para CORS.
ALLOWED_ORIGINS=http://localhost:8080

# Opcional: reCAPTCHA v3 — si se define, el body debe incluir recaptcha_token
# RECAPTCHA_SECRET_KEY=

# Local: ruta al JSON de cuenta de servicio (no subir a git)
# En Cloud Run: usar la cuenta de servicio del servicio (ADC), sin archivo.
# GOOGLE_APPLICATION_CREDENTIALS=/ruta/al/sa.json
